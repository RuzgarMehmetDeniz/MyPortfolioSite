@model MyPortfolioSite.Models.Project
@{
    Layout = null;
    ViewData["Title"] = Model.Title;
    var images = ViewBag.Images as List<string> ?? new List<string>();

    // Admin'deki demo adresi varsa o, yoksa GitHub'daki Website alanı.
    // Sadece https adresleri iframe'de açılır (http'yi tarayıcı engeller).
    var demo = Uri.TryCreate(Model.ShownDemo, UriKind.Absolute, out var demoUri)
               && demoUri.Scheme == Uri.UriSchemeHttps
        ? Model.ShownDemo
        : null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="_Head" />
</head>
<body>
    <partial name="_Background" />
    <partial name="_Navbar" />

    <div class="container">
        <a asp-action="Detail" asp-route-id="@Model.Name" class="text-muted text-decoration-none">‹ @Model.Title</a>
        <h1 class="mt-3">@Model.Title</h1>

        @if (demo != null)
        {
            <iframe src="@demo" title="@Model.Title" class="w-100 border rounded" style="height:70vh"></iframe>
            <a class="btn btn-outline-dark mt-2" href="@demo" target="_blank" rel="noopener">Yeni sekmede aç</a>
        }

        @if (images.Any())
        {
            <h2 class="h5 mt-4">Ekranlar</h2>
            <div id="shots" class="carousel slide border rounded p-2 bg-light">
                <div class="carousel-inner">
                    @for (int i = 0; i < images.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@images[i]" class="d-block mx-auto img-fluid" style="max-height:70vh" alt="@Model.Title ekran @(i + 1)">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#shots" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon bg-dark rounded-circle p-3"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#shots" data-bs-slide="next">
                    <span class="carousel-control-next-icon bg-dark rounded-circle p-3"></span>
                </button>
            </div>
        }

        @if (demo == null && !images.Any())
        {
            <div class="alert alert-secondary mt-3">
                Bu proje için gösterilecek bir şey bulunamadı.
            </div>
        }

        <div class="mb-5"></div>
    </div>
    <partial name="_Footer" />
    <partial name="_Chatbot" />

    <partial name="_Scripts" />
</body>
</html>